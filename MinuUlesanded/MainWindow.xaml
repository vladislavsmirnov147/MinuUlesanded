<Window x:Class="MinuUlesanded.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minu ülesanded"
        Height="750"
        Width="850"
        MinHeight="450"
        MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Background="#FFF1F6">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="25">

            <TextBlock Text="Minu ülesanded"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#C65388"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,5"/>

            <TextBlock Text="Planeeri oma õppimist lihtsalt ja mugavalt!"
                       FontSize="15"
                       Foreground="#777777"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="15"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="TotalText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#C65388"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Kõik ülesanded"
                                   HorizontalAlignment="Center"
                                   Foreground="#777777"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="15"
                        Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock x:Name="CompletedText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#5AAB83"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Tehtud"
                                   HorizontalAlignment="Center"
                                   Foreground="#777777"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="15"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="PendingText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#E78AB3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Tegemata"
                                   HorizontalAlignment="Center"
                                   Foreground="#777777"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Lisa uus ülesanne"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#C65388"/>

                    <TextBlock Text="Ülesande nimi"
                               Margin="0,15,0,5"/>

                    <TextBox x:Name="TaskTextBox"
                             Height="38"
                             FontSize="15"
                             Padding="10,7"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,8,0">
                            <TextBlock Text="Õppeaine"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="SubjectComboBox"
                                      Height="35"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Matemaatika"/>
                                <ComboBoxItem Content="Eesti keel"/>
                                <ComboBoxItem Content="Inglise keel"/>
                                <ComboBoxItem Content="Ajalugu"/>
                                <ComboBoxItem Content="Bioloogia"/>
                                <ComboBoxItem Content="Geograafia"/>
                                <ComboBoxItem Content="Füüsika"/>
                                <ComboBoxItem Content="Keemia"/>
                                <ComboBoxItem Content="Informaatika"/>
                                <ComboBoxItem Content="Muu"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Prioriteet"
                                       Margin="0,0,0,5"/>

                            <ComboBox x:Name="PriorityComboBox"
                                      Height="35"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="Kõrge"/>
                                <ComboBoxItem Content="Keskmine"/>
                                <ComboBoxItem Content="Madal"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tähtaeg"
                               Margin="0,15,0,5"/>

                    <DatePicker x:Name="TaskDatePicker"
                                Height="35"/>

                    <Button Content="Lisa ülesanne"
                            Height="43"
                            Margin="0,20,0,0"
                            Background="#E78AB3"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="AddButton_Click"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="15"
                    Padding="20"
                    MinHeight="180">

                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Minu nimekiri"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#C65388"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="FilterComboBox"
                                  Grid.Column="1"
                                  Width="140"
                                  Height="32"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="Kõik"/>
                            <ComboBoxItem Content="Tehtud"/>
                            <ComboBoxItem Content="Tegemata"/>
                        </ComboBox>
                    </Grid>

                    <StackPanel x:Name="TaskPanel"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText"
                       Text="Ülesandeid kokku: 0"
                       HorizontalAlignment="Center"
                       Foreground="#A64D79"
                       FontSize="14"
                       Margin="0,15,0,10"/>
        </StackPanel>
    </ScrollViewer>
</Window>
